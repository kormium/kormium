package = cvec

# Всё расширение — три строки C в этой секции. Заголовков нет: cinterop компилирует тело
# ниже в свои stub'ы и делает static-функцию вызываемой из Kotlin.
# libvec.a содержит только vec (собран с -DSQLITE_CORE); символы sqlite3_* остаются
# неразрешёнными и резолвятся на финальной линковке из sqlite3.a, вшитой в klib kormium-sqlite.
---
#include "sqlite3.h"

int sqlite3_vec_init(sqlite3*, char**, const void*);

static int kormium_register_vec(void) {
    return sqlite3_auto_extension((void(*)(void)) sqlite3_vec_init);
}
